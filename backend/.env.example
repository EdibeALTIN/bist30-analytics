# Backend — kopyalayın: cp .env.example .env
# Lokal geliştirme (opsiyonel; varsayılanlar yeterli)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite dosya yolu (Render'da rootDir=backend iken varsayılan: data/bist30.db)
# BIST_DATABASE_PATH=data/bist30.db

# Production (Render Dashboard → Environment)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
# BIST_DATABASE_PATH=data/bist30.db
